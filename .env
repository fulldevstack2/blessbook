# Deploy configuration. Checked in on purpose: these are not secrets, and the
# alternative is the origin being hardcoded in three places in index.html.
#
# VITE_BASE      the subpath the site is served from. A GitHub Pages project
#                repo serves at <account>.github.io/<repo>/, so this is the
#                repo name with slashes. Set to / for a custom domain.
#
# VITE_SITE_URL  the absolute origin, no trailing slash, used only by the
#                og: and twitter: tags. Link scrapers do not reliably resolve
#                a relative image, so this has to be absolute to work.
#
# The deploy workflow sets both explicitly as well, and a process env var wins
# over this file — so CI is authoritative and these are the local defaults that
# make a local build match production.

VITE_BASE=/blessbook/
VITE_SITE_URL=https://fulldevstack2.github.io/blessbook

# WhatsApp number for the Talk to us button (digits only, country code included).
# Leave unset until Dennis provides the number — the button stays hidden without it.
# VITE_WHATSAPP_NUMBER=
